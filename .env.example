# ==============================================================================
# CrewAI Studio & Multi-Agent Framework Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your keys.
# NEVER commit your actual .env file with secrets to public GitHub!
# ==============================================================================

# --- GitHub Integration (OAuth & API) ---
CLIENT_ID=
CLIENT_SECRET=
GITHUB_TOKEN=

# --- Google Jules Autonomous DevOps & Coding Agent ---
# Jules imports repos, boots ephemeral Cloud VMs, executes pytest/test suites, and creates PRs
JULES_API_KEY=
JULES_PROJECT_ID=
JULES_DEFAULT_BRANCH=main
JULES_VM_TIER=standard-4core
JULES_AUTO_PR_ENABLED=true

# --- Ollama & Local PC Hardware ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLOUD_ENDPOINTS=

# --- Core LLM Providers ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_0=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
DEEPSEEK_API_KEY=
GMICLOUD_API_KEY=
OPENROUTER_API_KEY=

# --- Antigravity (Google) ---
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_BASE_URL=https://antigravity.google/api/v1

# --- Web Search & Scraping Tools ---
SERPER_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=
SCRAPFLY_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Vector Databases & Cloud Storage ---
QDRANT_API_KEY=
QDRANT_URL=
WEAVIATE_API_KEY=
WEAVIATE_URL=
MONGODB_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- Automation & Agent Integrations ---
ZAPIER_API_KEY=
APIFY_API_TOKEN=
MULTION_API_KEY=

# --- Observability & Tracing ---
CREWAI_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
BRAINTRUST_API_KEY=